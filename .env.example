# Server
PORT=3000
NODE_ENV=development

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:19000

# Database type: 'sqlite' (default) or 'mariadb'
DB_TYPE=sqlite
DB_SQLITE_PATH=./briefly.db

# MariaDB (only needed if DB_TYPE=mariadb)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=briefly_dev

# API Keys (free tier)
OPENWEATHERMAP_API_KEY=your_key_here
NEWSAPI_KEY=your_key_here
ALPHA_VANTAGE_KEY=your_key_here

# Free LLM (Pollinations — no key needed)
FREE_LLM_BASE=https://text.pollinations.ai
FREE_LLM_MODEL=openai-fast

# Free APIs (no key needed)
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# OPENLIBRARY_BASE_URL=https://openlibrary.org
# ZENQUOTES_BASE_URL=https://zenquotes.io/api
