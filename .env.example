# Server
PORT=3001
NODE_ENV=development
# For staging: NODE_ENV=stage (runs with npm run start:stage)

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:19000

# Database type: 'sqlite' (default) or 'mariadb'
DB_TYPE=sqlite
DB_SQLITE_PATH=./briefly.db
# Set to true only in local/test environments where schema auto-sync is acceptable
DB_SYNCHRONIZE=true

# MariaDB (only needed if DB_TYPE=mariadb)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=briefly_dev

# API Keys (free tier)
OPENWEATHERMAP_API_KEY=your_key_here
NEWSAPI_KEY=your_key_here
ALPHA_VANTAGE_KEY=your_key_here
TOMTOM_API_KEY=
TOMTOM_BASE_URL=https://api.tomtom.com

# Free LLM (Pollinations — no key needed)
FREE_LLM_BASE=https://text.pollinations.ai
FREE_LLM_MODEL=openai-fast

# Auth token signing
AUTH_TOKEN_SECRET=replace_me_with_a_random_secret
# 30 days
AUTH_TOKEN_TTL_HOURS=720

# Price alerts
# Poll interval defaults to 5 minutes. Expo access token is optional for prototype traffic.
PRICE_ALERTS_ENABLED=true
PRICE_ALERT_POLL_INTERVAL_MS=300000
PRICE_ALERT_DEFAULT_THRESHOLD_PERCENT=3
EXPO_ACCESS_TOKEN=

# Email verification
# Set EMAIL_PROVIDER=resend and provide RESEND_API_KEY + EMAIL_FROM for real delivery.
# Keep EMAIL_PROVIDER=console for local testing (verification URL is logged + returned in dev response).
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Briefly <onboarding@briefly.app>"
EMAIL_REPLY_TO=
# Must be reachable from your phone/browser, e.g. https://xxxx.ngrok-free.app/api
EMAIL_VERIFICATION_BASE_URL=http://localhost:3001/api
# 24 hours
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440

# OAuth Providers
GOOGLE_OAUTH_CLIENT_ID=698637591184-h1crqmk5u6pd9vmp95vdks0gdqoj952n.apps.googleusercontent.com
GOOGLE_OAUTH_IOS_URL_SCHEME=com.googleusercontent.apps.698637591184-h1crqmk5u6pd9vmp95vdks0gdqoj952n
GOOGLE_PACKAGE_NAME=com.filipozbolt.briefly.dev

# LinkedIn OAuth
LINKEDIN_OAUTH_CLIENT_ID=your_linkedin_client_id
LINKEDIN_OAUTH_CLIENT_SECRET=your_linkedin_client_secret

# Free APIs (no key needed)
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# OPENLIBRARY_BASE_URL=https://openlibrary.org
# ZENQUOTES_BASE_URL=https://zenquotes.io/api
